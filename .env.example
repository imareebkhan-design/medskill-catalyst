SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSCODE=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-X693Z5PB0N
# Meta (Facebook) Pixel ID — public client-side identifier (not a secret).
# Used by the Next.js app (src/components/MetaPixel.tsx). The static marketing
# site keeps its own copy in assets/meta-pixel.js.
NEXT_PUBLIC_META_PIXEL_ID=2086725265526325

# ── Meta Conversions API (server-side) — src/lib/meta-capi.ts ──
# META_CAPI_ACCESS_TOKEN is a SECRET (Events Manager → Settings → Conversions
# API → Generate access token). Server-only — never expose it to the browser.
# Without it, all server-side CAPI calls no-op safely.
META_CAPI_ACCESS_TOKEN=
# Optional: server-side pixel/dataset id. Falls back to NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=2086725265526325
# Optional: Graph API version (default v21.0).
META_GRAPH_VERSION=v21.0
# Optional: paste a Test Events code here to verify server events in Events
# Manager → Test Events, then remove it for production.
META_CAPI_TEST_CODE=

# ── Razorpay (Standard Checkout) — src/lib/razorpay.ts ──
# KEY_ID + KEY_SECRET from Razorpay Dashboard → Settings → API Keys.
# Use rzp_test_… while testing, rzp_live_… in production. KEY_SECRET is a
# SECRET — server-only, never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Publishable key id for checkout.js in the browser (same value as RAZORPAY_KEY_ID).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SECRET set on the webhook you create in Dashboard → Settings → Webhooks.
# Used to verify X-Razorpay-Signature on /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ── Seller context for auto-generated GST invoices (optional) ──
SELLER_GSTIN=
SELLER_PLACE_OF_SUPPLY=

# ── Credential system (docs/credentials/DEPLOYMENT_CHECKLIST.md) ──
# Canonical origin for QR codes, emails and links. Required on production.
CREDENTIAL_PUBLIC_BASE_URL=https://medskillscatalyst.com
# off (default) | redirect | live   — live is honoured only on the production deployment.
CREDENTIAL_EMAIL_MODE=off
CREDENTIAL_EMAIL_REDIRECT_TO=
RESEND_API_KEY=
# Admin auth: passcode (default) | clerk. See docs/credentials/AUTH_ROLLOUT.md before changing.
ADMIN_AUTH_MODE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/staff-sign-in
BOOTSTRAP_ADMIN_EMAILS=
DATABASE_URL=
DIRECT_URL=
