import { NextResponse } from "next/server";
import { getServiceClient } from "@/lib/supabase";
import { validateRegistration, toPayload } from "@/lib/validation";
import type { RegistrationFormState } from "@/lib/types";

export const runtime = "nodejs";

export async function POST(req: Request) {
  let body: RegistrationFormState;
  try {
    body = (await req.json()) as RegistrationFormState;
  } catch {
    return NextResponse.json({ error: "Invalid JSON." }, { status: 400 });
  }

  // Server-side honeypot: bots fill the hidden "website" field.
  if ((body as unknown as { website?: string }).website) {
    return NextResponse.json({ ok: true }, { status: 200 }); // silently swallow
  }

  // Re-run the SAME validator the client used. Never trust the client.
  const errors = validateRegistration(body);
  if (Object.keys(errors).length > 0) {
    return NextResponse.json({ error: "Validation failed", fields: errors }, {
      status: 422,
    });
  }

  const payload = toPayload(body);

  try {
    const supabase = getServiceClient();
    const { error } = await supabase
      .from("webinar_registrations")
      .upsert(payload, { onConflict: "email" });

    if (error) {
      // Unique violation = already registered. Treat as success (idempotent).
      if (error.code === "23505") {
        return NextResponse.json({ ok: true, duplicate: true });
      }
      console.error("Supabase insert error:", error);
      return NextResponse.json(
        { error: "Could not save registration. Please try again." },
        { status: 500 }
      );
    }

    // Scaffold the email dispatch block (e.g. Resend / SendGrid / Nodemailer)
    // to send the 28-page PDF guide to the registered email address:
    console.log(`[Email Dispatch] Triggering welcome/guide email to: ${body.email}`);
    /*
    const resendApiKey = process.env.RESEND_API_KEY;
    if (resendApiKey) {
      // resend.emails.send({
      //   from: 'MedSkills Catalyst <admissions@medskillscatalyst.com>',
      //   to: body.email,
      //   subject: 'Your MedTech Career Transition Guide',
      //   html: '<p>Welcome! Here is your 28-page PDF guide...</p>'
      // });
    }
    */

    return NextResponse.json({ ok: true });
  } catch (err) {
    console.error("Register route error:", err);
    return NextResponse.json(
      { error: "Server misconfiguration. Please contact support." },
      { status: 500 }
    );
  }
}
